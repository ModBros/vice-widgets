{
  "name": "phone",
  "displayName": "Phone",
  "description": "A smartphone with a sunset wallpaper, a clock, the date and up to four apps that each run an action when tapped, e.g. open a website or lock the PC.",
  "filename": "Phone.tsx",
  "config": [
    {
      "name": "clock_format",
      "label": "Clock",
      "description": "The format of the clock",
      "type": "button-group",
      "options": [
        {
          "value": "24h",
          "label": "24 Hours"
        },
        {
          "value": "12h",
          "label": "12 Hours"
        }
      ],
      "defaultValue": "24h"
    },
    {
      "name": "wallpaper",
      "label": "Wallpaper",
      "description": "The background of the screen",
      "type": "button-group",
      "options": [
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "dusk",
          "label": "Dusk"
        },
        {
          "value": "night",
          "label": "Night"
        }
      ],
      "defaultValue": "sunset"
    },
    {
      "name": "font",
      "label": "Font",
      "description": "The font of the texts. Defaults to Bahnschrift, which ships with Windows",
      "type": "font"
    },
    {
      "name": "app_1_icon",
      "label": "Icon",
      "description": "The icon of the app. None hides it",
      "type": "select",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "web",
          "label": "Internet"
        },
        {
          "value": "chat",
          "label": "Messages"
        },
        {
          "value": "mail",
          "label": "Mail"
        },
        {
          "value": "music",
          "label": "Music"
        },
        {
          "value": "play",
          "label": "Play"
        },
        {
          "value": "map",
          "label": "Map"
        },
        {
          "value": "lock",
          "label": "Lock"
        },
        {
          "value": "power",
          "label": "Power"
        }
      ],
      "defaultValue": "web"
    },
    {
      "name": "app_1_label",
      "label": "Label",
      "description": "The name below the icon",
      "type": "string",
      "defaultValue": "Internet",
      "hideIf": {
        "field": "app_1_icon",
        "equals": "none"
      }
    },
    {
      "name": "app_1_action",
      "label": "Action",
      "description": "The action that runs when the app is tapped",
      "type": "action",
      "hideIf": {
        "field": "app_1_icon",
        "equals": "none"
      }
    },
